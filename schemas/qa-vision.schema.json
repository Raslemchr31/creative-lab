{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vision-QA verdict for one generated output (research/04 §6.2 Q1–Q5, Q11) — written by Claude or the owner after reading the compare sheet",
  "type": "object",
  "required": ["task_id", "verdict", "reviewer", "confidence"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string" },
    "verdict": { "enum": ["pass", "fail", "review"] },
    "select": { "type": "boolean", "description": "true = use this candidate downstream" },
    "same_product": { "type": ["boolean", "null"], "description": "null for product-free plates" },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "silhouette": { "enum": ["match", "minor_diff", "mismatch", "n/a"] },
        "colour": { "enum": ["match", "minor_diff", "mismatch", "n/a"] },
        "material": { "enum": ["match", "minor_diff", "mismatch", "n/a"] },
        "stitching": { "enum": ["match", "minor_diff", "mismatch", "n/a"] },
        "hardware": { "enum": ["match", "minor_diff", "mismatch", "n/a"] },
        "logo": { "enum": ["match", "not_legible", "misspelled", "moved", "added", "n/a"] }
      }
    },
    "invented_elements": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
    "anatomy_defects": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
    "mouth_moving": { "type": "boolean" },
    "text_in_plate": { "type": "boolean" },
    "morph_or_drift": { "type": "boolean", "description": "video: product changes shape/colour mid-clip" },
    "composition_ok": { "type": "boolean", "description": "subject placement leaves the overlay zones free; safe zones respected" },
    "style_match": { "type": "integer", "minimum": 1, "maximum": 5 },
    "aesthetic": { "type": "integer", "minimum": 1, "maximum": 5 },
    "notes": { "type": ["string", "null"], "maxLength": 600 },
    "fix": { "type": ["string", "null"], "maxLength": 400, "description": "What to change on retry (prompt clause, route, rung)." },
    "reviewer": { "enum": ["claude", "owner"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
